# قواعد التنقيح الأولية لتنبيهات مجموعة سُرى. تُشغَّل بالأمر: bash kit/redact.sh
# كل سطر قاعدة واحدة بصيغة sed -E. أضف قواعدك في آخر الملف.

# الأسماء في الحقول المسمّاة
s/("(user_name|guest_name)": ")[^"]*"/\1[NAME]"/g
# كلمة المرور داخل نص اتصال بقاعدة بيانات: ://user:password@host
s#(://[^:/@ ]+:)[^@ ]+@#\1[SECRET:password]@#g
# كلمات المرور في النماذج وفي سطر الأوامر
s/(password=)[^& "']+/\1[SECRET:password]/g
s/(--password ')[^']*'/\1[SECRET:password]'/g
# رموز الوصول الشخصية ومفاتيح الواجهات بصيغة المجموعة
s/sura_pat_[A-Za-z0-9]{24}/[SECRET:token]/g
s/SURA-KEY-[A-Z0-9]{16}/[SECRET:key]/g
# ملف تعريف جلسة نظام الحجوزات
s/(PMSSESSION=)[a-f0-9]+/\1[SECRET:cookie]/g
# البريد الإلكتروني والجوال
s/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]+/[EMAIL]/g
s/\+9665[0-9]{8}/[PHONE]/g

